{
  "expo": {
    "name": "family-tracker",
    "slug": "family-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.family-tracker",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Family Tracker uses your location to show it to your family group on the map.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-notifications"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3a1bd701-6f7c-4f0e-813f-194e41db962d"
      }
    },
    "owner": "brmendez"
  }
}
